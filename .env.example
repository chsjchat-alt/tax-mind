# ══════════════════════════════════════════════════════════════
# 蒙牛全产业链 AI 内生合规决策大脑 — Docker 部署环境变量模板（根目录）
# 复制为 .env 后按需修改；docker compose 自动读取本文件
# 后端本地开发（不走 Docker）请使用 backend/.env.example
# ══════════════════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_DB=taxmind
POSTGRES_USER=taxmind
# 数据库密码（生产必须修改为强密码）
POSTGRES_PASSWORD=taxmind123

# ── 启动强制项（缺失/占位符/非法均拒绝启动）──
# JWT 签名密钥（≥32 字符），生成：openssl rand -hex 32
JWT_SECRET_KEY=please-replace-me-with-openssl-rand-hex-32
# 字段加密密钥：32 字节随机数的标准 Base64（44 字符，以 = 结尾），生成：
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# ⚠️ 勿用 Fernet.generate_key()（URL-safe Base64，与本实现不兼容）
ENCRYPTION_KEY=please-replace-me-with-base64-of-32-random-bytes=

# ── 大模型 API（原型阶段可不填，系统降级为 Mock）──
DEEPSEEK_API_KEY=
QWEN_API_KEY=
LLM_PROVIDER=deepseek

# ── 其他可选 ──
APP_VERSION=0.3.0

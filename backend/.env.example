# 税智·心判 环境变量模板
# 复制为 .env 后按需修改

# ── 数据库 ──
# PostgreSQL + asyncpg（生产）
DATABASE_URL=postgresql+asyncpg://taxmind:taxmind@localhost:5432/taxmind
# 开发调试可切换为 SQLite：
# DATABASE_URL=sqlite+aiosqlite:///./taxmind.db

# ── 应用 ──
APP_NAME=税智·心判
APP_VERSION=0.3.0
DEBUG=false

# ── CORS ──
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── JWT ──
# JWT_SECRET_KEY=your-random-secret-key-at-least-32-chars
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 大模型 API ──
# DEEPSEEK_API_KEY=sk-xxx
# QWEN_API_KEY=sk-xxx
# LLM_PROVIDER=deepseek

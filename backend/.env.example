# ══════════════════════════════════════════════════════════════
# 蒙牛全产业链 AI 内生合规决策大脑 环境变量模板
# 复制为 .env 后按需修改；键名与 backend/app/config.py 的 Settings 字段一一对应
# ══════════════════════════════════════════════════════════════

# ── 数据库（必填） ──
# PostgreSQL + asyncpg（生产）
DATABASE_URL=postgresql+asyncpg://taxmind:taxmind@localhost:5432/taxmind
# 开发调试可切换为 SQLite：
# DATABASE_URL=sqlite+aiosqlite:///./taxmind.db

# 数据库连接池
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
# SSL/TLS 连接模式：require / verify-ca / verify-full / disable（留空同 disable）
# 开发环境（postgres 容器未开 SSL）必须设为 disable；生产环境至少 require（等保 2.0）
DB_SSL_MODE=disable

# ── 应用 ──
APP_NAME=蒙牛全产业链 AI 内生合规决策大脑
APP_VERSION=0.3.0
DEBUG=false

# ── CORS（JSON 数组格式） ──
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── JWT 认证（必填：JWT_SECRET_KEY） ──
# 生成命令：openssl rand -hex 32（要求 ≥ 32 字符，占位符会被启动校验拒绝）
# ⚠️ 泄漏可伪造任意用户 Token，禁止提交到代码库
JWT_SECRET_KEY=please-replace-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 字段加密（必填：ENCRYPTION_KEY） ──
# AES-256-GCM 密钥：32 字节随机数的【标准】Base64 编码（44 字符，以 = 结尾）
# 生成命令：python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# ⚠️ 勿用 Fernet.generate_key()——它生成 URL-safe Base64（含 - / _），与本实现不兼容
ENCRYPTION_KEY=please-replace-me-with-base64-of-32-random-bytes=

# ── 大模型 API（原型阶段 Mock，可留空） ──
DEEPSEEK_API_KEY=
QWEN_API_KEY=
LLM_PROVIDER=deepseek
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
